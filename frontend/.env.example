# Lambda Function URL. Used only by the dev proxy in vite.config.ts, so it is
# never bundled into the client. In production the Pages Function reads the
# project's own LAMBDA_URL variable instead.
#
# Copy this file to .env.local and fill in the real URL.
LAMBDA_URL=https://<id>.lambda-url.ap-northeast-2.on.aws/

# Kakao Maps JavaScript key. This one IS shipped to the browser (VITE_ prefix),
# which is expected -- restrict it by domain in the Kakao developer console.
VITE_KAKAO_MAP_APP_KEY=
