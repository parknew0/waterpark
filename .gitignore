.DS_Store
.env
.env.*
!.env.example

# Large reproducible source downloads kept locally.
# The exact nationwide flood manifest is tracked; the 54 MiB geometry source is
# recreated with scripts/download_korea_flood_trace.py after reuse terms are checked.
data/raw/flood-trace/korea_flood_2002_2022.geojson
data/raw/flood-trace/.korea_flood_2002_2022.parts/
# This is a complete source-attribute republication, so keep it local with the
# geometry until the same reuse terms are confirmed. Aggregate QA stays tracked.
data/interim/flood-trace/korea_flood_records.csv
data/raw/vworld-buildings/
data/raw/vworld-downloads/
data/raw/building-register/
data/raw/dem/
# 국토지리정보원 하천중심선 1.8 GB. VWorld 배포 페이지에 이용허락범위가
# 표기되어 있지 않아, 재배포 조건이 확인되기 전까지 원본은 로컬 전용이다.
data/raw/river-centerline/
# 사전계산 격자와 서빙 묶음은 스크립트로 재생성한다. 원본에서 파생된
# 14 MB 바이너리라 저장소에 두지 않고 manifest만 추적한다.
data/processed/risk-grid/
data/processed/serving-bundle/
serverless/bundle/
# Lambda 패키징 산출물. 스크립트로 재생성한다.
build/
*.zip
data/raw/overture/
data/raw/kma-rain/
data/raw/osm-cache/
data/raw/osm-routing/
data/interim/building-register/
data/interim/geometry-repaired/
# Per-building extracts of VWorld attributes (PNU, coordinates, use) are a
# substantial republication of the source, so they stay local like the raw
# shapefiles. The aggregate JSON summary beside them is tracked.
data/interim/vworld-buildings/*_flooded.csv
# Per-building VWorld attribute extracts, same reasoning as above.
data/interim/vworld-buildings/labeled_building_sample*.csv
data/processed/buildings/national_flooded_building_terrain.csv
data/processed/buildings/national_building_terrain_river_features.csv

# Generated inspection sidecar.
outputs/**/*.inspect.ndjson

# Python virtualenv for the analysis scripts.
.venv/

# React frontend local artifacts and secrets.
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
data/raw/kma-stations/kma_station_list_raw.csv

# 레이더 원자료 35 GB. 기상청 대용량 API로 재수집하며, 방법은
# docs/radar_download_plan.md 에 있다.
data/interim/radar/
# 학습표는 수백 MB이고 위 원자료에서 스크립트로 다시 만들어진다.
data/processed/ml/training/
# 지형·토지피복 격자 365 MB. compute_hydro_features.py,
# build_impervious_grid.py, build_landcover_grid.py 로 재생성한다.
data/interim/hydro/
# 침수흔적 기하에서 파생된 좌표들. 원본(korea_flood_2002_2022.geojson)이
# 재배포 조건 미확인으로 로컬 전용이므로 파생물도 같이 로컬에 둔다.
data/interim/flood-labels/
data/interim/geocoding/
config/radar/radar_points3.csv

# 30 m 격자 레이어 8.8 GB. scripts/build_grid30.py 로 재생성한다.
data/interim/grid30/
# 배수 관련 원본·중간물. 공공데이터 API와 VWorld에서 다시 받는다.
data/interim/drainage/
# numba 컴파일 캐시
scripts/__pycache__/
