.DS_Store
.env
.env.*
!.env.example

# Large reproducible source downloads kept locally.
# The exact nationwide flood manifest is tracked; the 54 MiB geometry source is
# recreated with scripts/download_korea_flood_trace.py after reuse terms are checked.
data/raw/flood-trace/korea_flood_2002_2022.geojson
data/raw/flood-trace/.korea_flood_2002_2022.parts/
# This is a complete source-attribute republication, so keep it local with the
# geometry until the same reuse terms are confirmed. Aggregate QA stays tracked.
data/interim/flood-trace/korea_flood_records.csv
data/raw/vworld-buildings/
data/raw/vworld-downloads/
data/raw/building-register/
data/raw/dem/
data/raw/overture/
data/raw/kma-rain/
data/interim/building-register/
data/interim/geometry-repaired/
# Per-building extracts of VWorld attributes (PNU, coordinates, use) are a
# substantial republication of the source, so they stay local like the raw
# shapefiles. The aggregate JSON summary beside them is tracked.
data/interim/vworld-buildings/*_flooded.csv

# Generated inspection sidecar.
outputs/**/*.inspect.ndjson

# Python virtualenv for the analysis scripts.
.venv/

# React frontend local artifacts and secrets.
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
data/raw/kma-stations/kma_station_list_raw.csv
